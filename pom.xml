<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.diag.practice</groupId>
    <artifactId>spring-ai-practice-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>spring-ai-practice</name>
    <description>Progressive drill-based practice for Spring AI and agentic systems architectures.</description>

    <modules>
        <module>phase01-ex01-chat-basics</module>
        <module>phase01-ex02-chat-advanced</module>
        <module>phase01-ex03-cloud-sre</module>
        <module>phase02-ex01-structured-outputs</module>
        <module>phase02-ex02-resilient-decisions</module>
        <module>phase03-ex01-tool-sandboxing</module>
        <module>phase03-ex02-multi-tool-drills</module>
        <module>phase04-ex01-guardrail-advisors</module>
        <module>phase04-ex02-resilient-guardrails</module>
        <module>phase05-ex01-offline-harness</module>
        <module>phase05-ex02-advanced-harness</module>
        <module>phase06-ex01-evaluators</module>
        <module>phase06-ex02-advanced-judges</module>
        <module>phase07-ex01-vector-stores</module>
        <module>phase07-ex02-rag-advisors</module>
        <module>phase08-ex01-mcp-server</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
